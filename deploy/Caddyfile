{
	email khanhduyvt0101@gmail.com
	admin localhost:2019
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

(common) {
	encode zstd gzip
	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}
	request_body {
		max_size 1MB
	}
	log {
		output stdout
		format json
	}
}

(dns_tls) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
}

# Preview stays separate and cannot add noindex to production responses.
57-129-182-242.sslip.io {
	import common
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy app:46480
}

www.khanhduy.com {
	import common
	import dns_tls
	reverse_proxy app:46480
}

khanhduy.com {
	import common
	import dns_tls
	redir https://www.khanhduy.com{uri} 308
}

# Preserve Infisical's existing shared proxy and external edge network.
infisical.server.khanhduy.com {
	encode zstd gzip
	header -Server
	request_body {
		max_size 10MB
	}
	log {
		output stdout
		format json
	}
	reverse_proxy infisical-backend:8080
}
