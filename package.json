{
  "name": "khanhduy-portfolio",
  "version": "0.0.0",
  "description": "Personal portfolio site for Khanh Duy, built with Next.js, React, Tailwind CSS, and Bun.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check": "bun --bun tsc --build && bun --bun biome check",
    "format": "bun --bun biome format --write",
    "build": "NODE_ENV=production next build",
    "dev": "next dev -p 46480",
    "start": "NODE_ENV=production next start -p 46480",
    "test": "vitest run"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@next/bundle-analyzer": "^16.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@tsconfig/bun": "^1.0.11",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-istanbul": "4.1.11",
    "jsdom": "30.0.1",
    "postcss": "^8.5.26",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanhduyvt0101/khanhduy-portfolio.git"
  },
  "license": "ISC",
  "homepage": "https://www.khanhduy.com"
}
